includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app
        - database
        - routes
        - tests

    # Start at 5 on a new project and raise it as types settle. 10 is the maximum
    # and realistically needs barryvdh/laravel-ide-helper for Eloquent magic.
    level: 5

    # On an existing codebase, generate a baseline once so new code is held to the
    # level while legacy findings stay recorded rather than blocking:
    #   ./vendor/bin/phpstan analyse --generate-baseline
    # baseline: phpstan-baseline.neon

    # Needs barryvdh/laravel-ide-helper to be useful on dynamic create()/update()
    # calls; left off until that is in place.
    checkModelProperties: false

    excludePaths:
        - app/Console/Kernel.php (?)
        # Pest's $this-> test API isn't understood without the Pest PHPStan plugin.
        - tests/Feature/*
